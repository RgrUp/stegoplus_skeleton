{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StegoPlus",
  "version": "1.0.1",
  "identifier": "com.kevindunton.stegoplus",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StegoPlus - Secure Stenography Utility",
        "width": 900,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true
      },
      {
        "label": "splash",
        "title": "StegoPlus",
        "url": "splash.html",
        "width": 720,
        "height": 405,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
